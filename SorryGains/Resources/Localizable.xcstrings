    "app.persistence_error.message": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The local database could not be opened, so this launch is using temporary storage. Records added now may disappear after the app closes. Please restart the app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "端末内データベースを開けなかったため、一時保存で起動しています。この状態で追加した記録はアプリ終了後に消える可能性があります。アプリを再起動してください。"
          }
        }
      }
    },
