    "飲酒が筋肉に与えるダメージの大きさを表します。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲酒が筋肉に与えるダメージの大きさを表します。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Indicates how much damage drinking does to your muscles."
          }
        }
      }
    },
    "飲酒量(g) × 体格補正 × トレーニング補正": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲酒量(g) × 体格補正 × トレーニング補正"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "alcohol(g) × body adjustment × training adjustment"
          }
        }
      }
    },
    "体重が軽いほどスコアが高くなります": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体重が軽いほどスコアが高くなります"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lighter body weight raises the score"
          }
        }
      }
    },
    "トレーニング頻度が高いほどスコアが高くなります（筋肉への影響が大きいため）": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーニング頻度が高いほどスコアが高くなります（筋肉への影響が大きいため）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Higher training frequency raises the score (because the impact on muscle is greater)"
          }
        }
      }
    },
    "上限は100。お詫び行動でスコアを下げられます": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上限は100。お詫び行動でスコアを下げられます"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Capped at 100. Recovery actions can lower the score"
          }
        }
      }
    },
    "筋肉がどれだけ怒っているかを表します。影響スコアから自動で決まります。": {
      "localizations": {
        "ja": {
