    "onboarding.disclaimer.body": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This app is not medical or health advice.\n\nAll numbers are for fun, not science.\n\nMade for responsible adults 20+ to enjoy."
