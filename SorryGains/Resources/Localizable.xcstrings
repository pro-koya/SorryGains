            "state": "translated",
            "value": "Training gains / Muscle down"
          }
        }
      }
    },
    "筋トレした日としていない日で意味が変わります。": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋トレした日としていない日で意味が変わります。"
