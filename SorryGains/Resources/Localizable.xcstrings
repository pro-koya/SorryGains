    },
    "notif.friday.body.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今夜も飲むのか...？俺の覚悟はできてる。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drinking again tonight...? I'm braced for it."
          }
        }
      }
    },
    "notif.friday.body.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金曜だな。今夜の分は明日で返せよ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's Friday. Pay tonight back tomorrow, got it?"
          }
        }
      }
    },
    "notif.friday.body.3": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "週末か...俺は見てるぞ、お前の選択を。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekend, huh... I'm watching every choice you make."
          }
        }
      }
    },
    "notif.friday.body.4": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "金曜の夜。飲むなら記録しろ。逃げるなよ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Friday night. If you drink, log it. No running."
          }
        }
      }
    },
    "notif.morning.body.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日の件...覚えてるか？お詫びまだだぞ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About last night... remember? You haven't apologized yet."
          }
        }
      }
    },
    "notif.morning.body.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おはよう。昨日%lld杯飲んだな。覚えてるか？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Morning. You had %lld drinks yesterday. Remember?"
          }
        }
      }
    },
    "notif.morning.body.3": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日の筋肉へのダメージ...まだ取り返せる。今日動け。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday's damage to your muscle... still recoverable. Move today."
          }
        }
      }
    },
    "notif.morning.body.4": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "起きたか。昨日の借りを返す日だぞ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Awake? Today's the day to repay yesterday's debt."
          }
        }
      }
    },
    "notif.deadline.body.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと2時間。プロテインくらい飲めるだろ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "2 hours left. You can at least drink protein."
          }
        }
      }
    },
    "notif.deadline.body.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お詫び期限が迫ってるぞ。まだ間に合う。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery deadline is closing in. Still time to act."
          }
        }
      }
    },
    "notif.deadline.body.3": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あと少しで期限切れだ。筋肉に何かしてやれ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Almost out of time. Do something for your muscle."
          }
        }
      }
    },
    "notif.deadline.body.4": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カウントダウン開始だ。今日できることをやれ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Countdown started. Do what you can today."
          }
        }
      }
    },
    "notif.sober.body.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日飲んでないな...見直したぞ。この調子だ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 days sober... I'm impressed. Keep it up."
          }
        }
      }
    },
    "notif.sober.body.2": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日連続休肝日！筋肉が喜んでるぞ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "3 alcohol-free days in a row! Your muscle is happy."
          }
        }
      }
    },
    "notif.sober.body.3": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すごいじゃないか。この調子で続けろ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not bad at all. Keep going."
          }
        }
      }
    },
    "notif.sober.body.4": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3日間の努力、ちゃんと見てたぞ。立派だ。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've been watching your 3-day effort. Respect."
          }
        }
      }
    },
    "notif.session.body.1": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1時間経過。大胸筋がざわついてきたぞ。"
