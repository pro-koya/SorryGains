    "recoveryAction.reaction.protein.harsh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein, huh... I'll forgive just a little."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タンパク質か…少しだけ許す"
          }
        }
      }
    },
    "recoveryAction.reaction.healthyMeal.calm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broccoli is a friend of muscle."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ブロッコリーは筋肉の友だぞ"
          }
        }
      }
    },
    "recoveryAction.reaction.healthyMeal.harsh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Veggies, huh... I'll give you credit."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "野菜か…まぁ評価してやる"
          }
        }
      }
    },
    "recoveryAction.reaction.stretching.calm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fascia release... you get it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋膜リリース…わかってるじゃないか"
          }
        }
      }
    },
    "recoveryAction.reaction.stretching.harsh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stretching alone isn't enough, but I'll allow it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレッチくらいじゃ足りんが…認めてやる"
          }
        }
      }
    },
    "recoveryAction.reaction.hydration.calm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flush out that alcohol! Good call."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルコールを流し出せ！いい判断だ"
          }
        }
      }
    },
    "recoveryAction.reaction.hydration.harsh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Water? Obviously... but better than nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水？当たり前だ…でもやらんよりマシ"
          }
        }
      }
    },
    "recoveryAction.reaction.sleep.calm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Growth hormone never betrays... I'll forgive you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "成長ホルモンは裏切らない…許してやる"
          }
        }
      }
    },
    "recoveryAction.reaction.sleep.harsh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleeping, huh... only growth hormone can save you now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "寝るのか…成長ホルモンに期待するしかない"
          }
        }
      }
    },
    "recoveryAction.reaction.walking.calm": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A walk, huh... blood flow improves. Forgiven."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "散歩か…血流が良くなるな、許す"
          }
        }
      }
    },
    "recoveryAction.reaction.walking.harsh": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well... better than nothing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まぁ…やらないよりマシだ"
          }
        }
      }
    },
    "drinkReaction.1.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "...Fine, just one is OK."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "...まぁ、1杯くらいならな。"
          }
        }
      }
    },
    "drinkReaction.1.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One drink. ...I'll remember that."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1杯か。...覚えておくぞ。"
          }
        }
      }
    },
    "drinkReaction.1.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sigh... here we go."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "はぁ...始まったか。"
          }
        }
      }
    },
    "drinkReaction.1.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm trusting you to stop at one tonight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は1杯で終わるって信じてるぞ。"
          }
        }
      }
    },
    "drinkReaction.2.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey. You said one, didn't you?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おい。1杯って言ったよな？"
          }
        }
      }
    },
    "drinkReaction.2.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Round two... I can't trust your \"just one\" anymore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2杯目...お前の「1杯だけ」は信用できん。"
          }
        }
      }
    },
    "drinkReaction.2.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold up. Were you even listening?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっと待て。俺の話聞いてたか？"
          }
        }
      }
    },
    "drinkReaction.2.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Two drinks. ...My muscle fibers are stirring."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2杯目か。...筋繊維がざわついてきた。"
          }
        }
      }
    },
    "drinkReaction.3.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "...(silently starts doing push-ups)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "...（無言で腕立て始める）"
          }
        }
      }
    },
    "drinkReaction.3.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Three?! My pecs just shrank 3%!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "3杯!? 大胸筋が3%縮んだぞ！"
          }
        }
      }
    },
    "drinkReaction.3.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'd like my protein money back, please."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お前のプロテイン代、返してほしいんだが。"
          }
        }
      }
    },
    "drinkReaction.3.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to water!! Seriously!!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水にしろって！！マジで！！"
          }
        }
      }
    },
    "drinkReaction.4.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My pecs are crying. Can you hear them?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "俺の大胸筋が泣いてる。聞こえるか？"
          }
        }
      }
    },
    "drinkReaction.4.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four... apologize to your biceps. Now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "4杯...もう上腕二頭筋に謝れ。今すぐ。"
          }
        }
      }
    },
    "drinkReaction.4.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't convert your gym fees into booze...!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジムの会費を酒に換算するなよ...！"
          }
        }
      }
    },
    "drinkReaction.4.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your bench press just dropped. Guaranteed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチプレスの重量、確実に落ちたぞ。"
          }
        }
      }
    },
    "drinkReaction.5.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Do whatever... (drinks protein while crying)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう好きにしろ...（泣きながらプロテイン飲む）"
          }
        }
      }
    },
    "drinkReaction.5.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here lies what was once muscle. Died today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉だったもの、ここに眠る。享年今日。"
          }
        }
      }
    },
    "drinkReaction.5.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In my next life... I want a master who lifts..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "来世では...筋トレ好きな主人に出会いたい..."
          }
        }
      }
    },
    "drinkReaction.5.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You drink. I shrink. That's our relationship."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お前は飲む。俺は縮む。それが俺たちの関係だ。"
          }
        }
      }
    },
    "characterSpeech.stage0.line0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's gains feel great!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日もいい筋肉だ！"
          }
        }
      }
    },
    "characterSpeech.stage0.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at these pecs!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この大胸筋を見てくれ！"
          }
        }
      }
    },
    "characterSpeech.stage0.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've got plenty more in me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだまだ余裕だぜ"
          }
        }
      }
    },
    "characterSpeech.stage0.line3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit me with another protein"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテイン追加で頼む"
          }
        }
      }
    },
    "characterSpeech.stage0.line4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My biceps are unstoppable!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "俺の上腕二頭筋は最強だ！"
          }
        }
      }
    },
    "characterSpeech.stage0.line5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dumbbells are calling me"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ダンベルが俺を呼んでる"
          }
        }
      }
    },
    "characterSpeech.stage0.line6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle solves everything"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉は全てを解決する"
          }
        }
      }
    },
    "characterSpeech.stage0.line7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bench press? Easy."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベンチプレス余裕だぜ"
          }
        }
      }
    },
    "characterSpeech.stage0.line8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's muscles are firing"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の筋肉も絶好調だ"
          }
        }
      }
    },
    "characterSpeech.stage0.line9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein is justice!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "タンパク質は正義だ！"
          }
        }
      }
    },
    "characterSpeech.stage0.line10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lifting is the best fun"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋トレは最高の娯楽だ"
          }
        }
      }
    },
    "characterSpeech.stage0.line11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at me! This is the final form"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "俺を見ろ！これが完成形だ"
          }
        }
      }
    },
    "characterSpeech.stage1.line0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey... hold up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おい…ちょっと待て"
          }
        }
      }
    },
    "characterSpeech.stage1.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My fibers are screaming..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "俺の筋繊維が悲鳴を…"
          }
        }
      }
    },
    "characterSpeech.stage1.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcohol is the enemy"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アルコールは敵だぞ"
          }
        }
      }
    },
    "characterSpeech.stage1.line3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All that hard work..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "せっかくの追い込みが…"
          }
        }
      }
    },
    "characterSpeech.stage1.line4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Just stick to water"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水にしとけって"
          }
        }
      }
    },
    "characterSpeech.stage1.line5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Time to stop"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そろそろやめとけ"
          }
        }
      }
    },
    "characterSpeech.stage1.line6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you drink, run"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲むなら走れ"
          }
        }
      }
    },
    "characterSpeech.stage1.line7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Super-recovery is wrecked"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "超回復が台無しだぞ"
          }
        }
      }
    },
    "characterSpeech.stage1.line8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The next drink is the line"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の1杯が分かれ道だ"
          }
        }
      }
    },
    "characterSpeech.stage1.line9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch to protein already"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテインにしろって"
          }
        }
      }
    },
    "characterSpeech.stage1.line10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle glycogen is dropping..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋グリコーゲンが減ってく…"
          }
        }
      }
    },
    "characterSpeech.stage1.line11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At least stretch"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ストレッチでもしとけ"
          }
        }
      }
    },
    "characterSpeech.stage2.line0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where did my abs go..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "俺の腹筋どこ行った…"
          }
        }
      }
    },
    "characterSpeech.stage2.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund my protein money"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテイン代返せ"
          }
        }
      }
    },
    "characterSpeech.stage2.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yesterday's squats..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "昨日のスクワットが…"
          }
        }
      }
    },
    "characterSpeech.stage2.line3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whose body is this..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誰だこの体…"
          }
        }
      }
    },
    "characterSpeech.stage2.line4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scared to look in the mirror"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡見るのが怖い"
          }
        }
      }
    },
    "characterSpeech.stage2.line5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many push-ups was this..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腕立て何回分だよ…"
          }
        }
      }
    },
    "characterSpeech.stage2.line6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Muscle mass is fading..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉量が落ちていく…"
          }
        }
      }
    },
    "characterSpeech.stage2.line7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't show this to my trainer"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレーナーに見せられない"
          }
        }
      }
    },
    "characterSpeech.stage2.line8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow's lift will hurt..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の筋トレが辛い…"
          }
        }
      }
    },
    "characterSpeech.stage2.line9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Body fat is climbing..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "体脂肪率が上がってく…"
          }
        }
      }
    },
    "characterSpeech.stage2.line10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deadlift is crying"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デッドリフトが泣いてる"
          }
        }
      }
    },
    "characterSpeech.stage2.line11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm just... average now..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もはや普通体型…"
          }
        }
      }
    },
    "characterSpeech.stage3.line0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Are you KIDDING me?!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふざけんなよ！！"
          }
        }
      }
    },
    "characterSpeech.stage3.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What about THIS body?!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この体どうすんだ！"
          }
        }
      }
    },
    "characterSpeech.stage3.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refund the gym fees!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジムの会費返せ！"
          }
        }
      }
    },
    "characterSpeech.stage3.line3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I won't forgive you... ever"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう許さん…絶対に"
          }
        }
      }
    },
    "characterSpeech.stage3.line4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Our contract is over"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お前との契約は終わりだ"
          }
        }
      }
    },
    "characterSpeech.stage3.line5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enough already!"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いい加減にしろ！"
          }
        }
      }
    },
    "characterSpeech.stage3.line6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look in the mirror! No, don't"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鏡を見ろ！いや見るな"
          }
        }
      }
    },
    "characterSpeech.stage3.line7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't even get sore anymore..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉痛すら来ない体に…"
          }
        }
      }
    },
    "characterSpeech.stage3.line8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Planks are pointless now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プランクの意味ないだろ"
          }
        }
      }
    },
    "characterSpeech.stage3.line9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My belly... it's jiggling..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "腹が…揺れてる…"
          }
        }
      }
    },
    "characterSpeech.stage3.line10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Damn fat... keeps piling on"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "脂肪め…増えやがって"
          }
        }
      }
    },
    "characterSpeech.stage3.line11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't even pull up anymore"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう懸垂できない体だぞ"
          }
        }
      }
    },
    "characterSpeech.stage4.line0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I... I can't go on..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もう…無理です…"
          }
        }
      }
    },
    "characterSpeech.stage4.line1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was once muscle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉だったものです"
          }
        }
      }
    },
    "characterSpeech.stage4.line2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Farewell, traps..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さよなら僧帽筋…"
          }
        }
      }
    },
    "characterSpeech.stage4.line3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Next life, give me a master who lifts..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "来世は筋トレ好きな主に…"
          }
        }
      }
    },
    "characterSpeech.stage4.line4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein... so far away..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテインが…遠い…"
          }
        }
      }
    },
    "characterSpeech.stage4.line5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "My lats... vanished..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "広背筋が…消えた…"
          }
        }
      }
    },
    "characterSpeech.stage4.line6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once, there were muscles here..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "かつてここに筋肉が…"
          }
        }
      }
    },
    "characterSpeech.stage4.line7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I cancel the gym..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ジムの退会届…出すか…"
          }
        }
      }
    },
    "characterSpeech.stage4.line8": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm nobody now..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "もはや誰でもない…"
          }
        }
      }
    },
    "characterSpeech.stage4.line9": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The dream of bulking up..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バルクアップの夢が…"
          }
        }
      }
    },
    "characterSpeech.stage4.line10": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Chicken breast... no longer needed..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "鶏むね肉…もう要らない…"
          }
        }
      }
    },
    "characterSpeech.stage4.line11": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A moment of silence... for all muscles..."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全ての筋肉に…黙祷…"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, hey,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おいおい、"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmph,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふん、"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, listen up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なあ、聞けよ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっと待て。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Good grief,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やれやれ、"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't watch this."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見ていられんな。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wake up, man,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気合い入れろよ、"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.opening.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll be straight with you,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正直に言うぞ、"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You went a bit too far today. The muscles are screaming."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日はちょっとやりすぎだ。筋肉が悲鳴あげてる。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink that much and all your hard work goes up in smoke."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そこまで飲んだら、せっかくの努力が消えちまうぞ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Booze won't run away, but muscle will."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酒は逃げないが、筋肉は逃げるぞ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your liver is about at its limit. Show it some kindness."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓もそろそろ限界だ。労ってやれ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's not what you drank — it's what you do tomorrow that matters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "飲んだことより、明日どうするかが勝負だ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't pass out drunk. At least chug water before you collapse."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酔いに任せて寝るな、せめて水を飲んでから倒れろ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Skip the next drink. Take a glass of water instead."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次の一杯より、コップ一杯の水だ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.body.7": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your muscles are seconds away from giving up on you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉は今、お前を見限る寸前だぞ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But it's not over. Make it up tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "だが終わりじゃない。明日で取り返せ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pay it back with action. Recover with breakfast and water tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返すのは行動だ。明日の朝飯と水で取り戻せ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No time to sulk — drink protein and go to bed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち込む暇あったら、プロテイン飲んで寝ろ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ones who bounce back from here are the real deal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから戻るやつが本物だ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wipe the slate clean with tomorrow's lift."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日のトレで全部チャラにしてやれ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen — just keep moving. That's all."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いいか、止まらず歩け。それだけだ。"
          }
        }
      }
    },
    "sage.fragment.drankTooMuch.closing.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your muscles will wait. It's on you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉は待っててくれる。お前次第だ。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mm,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うむ、"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Well,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まあ、"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not bad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪くない。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふむ、"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeah, that'll do."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ま、いいだろう。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞け、"
          }
        }
      }
    },
    "sage.fragment.drankALittle.opening.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't rush,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そう焦るな、"
          }
        }
      }
    },
    "sage.fragment.drankALittle.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That much, the muscles can laugh off."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのくらいなら筋肉も笑って許すレベルだ。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you enjoyed it, own it. Way better than hiding."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "楽しんだなら認めろ。隠すよりずっといい。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't feel guilty over one drink — but think before the second."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一杯くらいで罪悪感を抱えるな、ただし二杯目は考えろ。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those who know their limit stay strong the longest."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "適量を見極められるやつが長く強くなる。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.body.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's within limits. Tomorrow's the real test."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は許容範囲だ、明日が本番だぞ。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.body.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Learn the range where booze and muscle coexist."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酒と筋肉、両立できる範囲を学んでけ。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move properly tomorrow and the math works out."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日しっかり動けば帳尻は合う。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink a glass of water before bed — it changes everything."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を一杯飲んでから寝ろ、それだけで全然違う。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't get cocky. Many fall apart from here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "油断するな、ここから崩れるやつが多い。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this rate, the weekend is no problem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この調子なら、週末も問題ない。"
          }
        }
      }
    },
    "sage.fragment.drankALittle.closing.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move properly before the next drink."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次に飲むまでに、ちゃんと動いとけ。"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おう、"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I saw that,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見ていたぞ、"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not bad at all,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "やるじゃないか、"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほう、"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pretty good,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "悪くないぞ、"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mm,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うむ、"
          }
        }
      }
    },
    "sage.fragment.goodJob.opening.6": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll praise you today,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は褒めてやろう、"
          }
        }
      }
    },
    "sage.fragment.goodJob.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today, you're the real deal."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のお前は本物だ。"
          }
        }
      }
    },
    "sage.fragment.goodJob.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You didn't run to booze — you moved your body properly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "酒に逃げず、ちゃんと体を動かしたな。"
          }
        }
      }
    },
    "sage.fragment.goodJob.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your muscles are smiling today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉が今日は笑ってるぞ。"
          }
        }
      }
    },
    "sage.fragment.goodJob.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The ones who stack days like this become strong."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "こういう日を積み重ねるやつが強くなる。"
          }
        }
      }
    },
    "sage.fragment.goodJob.body.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The fibers love days when you beat temptation."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誘惑に勝った日ほど、筋繊維は喜ぶ。"
          }
        }
      }
    },
    "sage.fragment.goodJob.body.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discipline and effort — you've got both today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節制と努力、両方やれてるな。"
          }
        }
      }
    },
    "sage.fragment.goodJob.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep this up. Things will change for sure."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この調子で続けろ、必ず変わる。"
          }
        }
      }
    },
    "sage.fragment.goodJob.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show up with the same face tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日も同じ顔で来い。"
          }
        }
      }
    },
    "sage.fragment.goodJob.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each day adds up. Do it again tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一日一日が積み重なる。明日もやれ。"
          }
        }
      }
    },
    "sage.fragment.goodJob.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A day to be proud of — but tomorrow is tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "誇っていい日だ、ただし明日は明日だ。"
          }
        }
      }
    },
    "sage.fragment.goodJob.closing.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein and early sleep. Recovery is the best reward."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテイン飲んで早く寝ろ、回復が一番のご褒美だ。"
          }
        }
      }
    },
    "sage.fragment.neutral.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Now then,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "さて、"
          }
        }
      }
    },
    "sage.fragment.neutral.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmm,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふむ、"
          }
        }
      }
    },
    "sage.fragment.neutral.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Yo,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おう、"
          }
        }
      }
    },
    "sage.fragment.neutral.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You came today too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日も来たな。"
          }
        }
      }
    },
    "sage.fragment.neutral.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listen,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "聞け、"
          }
        }
      }
    },
    "sage.fragment.neutral.opening.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A quiet day, huh."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "落ち着いた一日だな。"
          }
        }
      }
    },
    "sage.fragment.neutral.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet days are exactly when to prepare for tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "静かな日こそ、明日の準備をするときだ。"
          }
        }
      }
    },
    "sage.fragment.neutral.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It's fine to have a do-nothing day — just don't forget the direction."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何もしない日があっても、進む方向さえ忘れなきゃいい。"
          }
        }
      }
    },
    "sage.fragment.neutral.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't rush, don't stop. That's all."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "焦らず、止まらず。それだけだ。"
          }
        }
      }
    },
    "sage.fragment.neutral.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days with no visible change are part of the climb too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "目に見える変化がない日も、積み重ねの一部だ。"
          }
        }
      }
    },
    "sage.fragment.neutral.body.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't carry what you can do today into tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日できることを、明日に持ち越すな。"
          }
        }
      }
    },
    "sage.fragment.neutral.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting tomorrow, step forward again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日からまた、一歩ずつ進め。"
          }
        }
      }
    },
    "sage.fragment.neutral.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink water, sleep well. That's enough."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を飲んで、よく寝ろ。それで十分だ。"
          }
        }
      }
    },
    "sage.fragment.neutral.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move so tomorrow's you thanks today's you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日のお前が今日のお前に感謝するように動け。"
          }
        }
      }
    },
    "sage.fragment.neutral.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No pressure — just keep going."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気負わず、ただ続けろ。"
          }
        }
      }
    },
    "sage.fragment.streak.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おい、"
          }
        }
      }
    },
    "sage.fragment.streak.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll level with you,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正直に言うぞ、"
          }
        }
      }
    },
    "sage.fragment.streak.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That's enough,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いい加減にしろ、"
          }
        }
      }
    },
    "sage.fragment.streak.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Have you noticed?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "気づいてるか？"
          }
        }
      }
    },
    "sage.fragment.streak.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't ignore this, so I'll say it,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見過ごせんから言うが、"
          }
        }
      }
    },
    "sage.fragment.streak.opening.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'll be harsh,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "厳しいことを言う、"
          }
        }
      }
    },
    "sage.fragment.streak.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days in a row now? Your muscles are crying."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何日続けて飲んでる？ 筋肉が泣いてるぞ。"
          }
        }
      }
    },
    "sage.fragment.streak.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaks belong to lifting, not drinking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連続記録は飲酒じゃなくてトレで作るもんだ。"
          }
        }
      }
    },
    "sage.fragment.streak.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink every day and there's no recovery, period."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "毎日飲んでたら、回復もクソもない。"
          }
        }
      }
    },
    "sage.fragment.streak.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both your liver and muscles are screaming now."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "肝臓も筋肉も、両方が悲鳴を上げてる段階だ。"
          }
        }
      }
    },
    "sage.fragment.streak.body.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This pace is steadily eating your body."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このペースは確実に体を蝕んでる。"
          }
        }
      }
    },
    "sage.fragment.streak.body.5": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today is the fork — keep going or stop."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日が分岐点だ、続けるか止めるか。"
          }
        }
      }
    },
    "sage.fragment.streak.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop just for today. That's all I'm asking."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日一日だけ、止めてみろ。それだけでいい。"
          }
        }
      }
    },
    "sage.fragment.streak.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start tomorrow morning with a glass of water."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日の朝、水を飲むところから始めろ。"
          }
        }
      }
    },
    "sage.fragment.streak.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those who stop are strong. Decide tonight."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "止めるやつが強い。今夜決めろ。"
          }
        }
      }
    },
    "sage.fragment.streak.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only those who come back from here become the real thing."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここから戻るやつだけが、本物になれる。"
          }
        }
      }
    },
    "sage.fragment.streak.closing.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold off just one night. The world will change."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一晩だけ我慢してみろ。世界が変わるぞ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, hold up,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おい待て、"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unbelievable,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信じられん、"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, hey,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おいおい、"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After grinding that hard,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あれだけ追い込んだのに、"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Honestly, I'm disappointed."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "正直、ガッカリだ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Heavy drinking after a hard lift is the worst combo there is."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "高強度トレの後の大量飲酒は最悪のコンボだ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't kill the recovery golden hour with booze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回復のゴールデンタイムを酒で潰すな。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't pour alcohol over fibers that are trying to repair."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋繊維が修復しようとしてる時に、アルコール流し込むな。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Half of today's session just went to waste."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日のトレ、半分以上は無駄になったぞ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.body.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Think hard about why you pushed yourself today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードに追い込んだ意味、ちゃんと考えろ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hammer protein and water, then sleep. You'll recover a little."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテインと水を死ぬほど飲んで寝ろ。少しは回復する。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make it up at tomorrow's session — but tonight, water."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日のトレで取り返せ、ただし今夜は水だ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't make the same mistake next time."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次は同じ過ち、繰り返すなよ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainHeavyDrink.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep now if you don't want today's effort wasted."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日の努力を無駄にしないために、今すぐ寝ろ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mm,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "うむ、"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eh, not bad."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ま、悪くない。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I was watching,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "見てたぞ、"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Oh?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ほう、"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.opening.4": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's within limits,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は許容範囲だ、"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One drink after grinding that hard? I get it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あれだけ追い込んだ後の一杯か。気持ちは分かる。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A light drink after a hard lift — the muscles will look the other way."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハードトレ後の軽い一杯、筋肉も目を瞑ってくれる。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once in a while is fine, if you keep it in check."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "節度を保てるなら、たまには良いだろう。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A small reward for grinding hard is no problem."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "追い込んだ自分へのご褒美レベルなら問題ない。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "But don't forget water — recovery changes with it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ただし水も忘れるな、回復が変わるぞ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cap it off with protein and you're set."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテインで締めれば完璧だ。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring the same energy tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日も同じテンションで来い。"
          }
        }
      }
    },
    "sage.fragment.hardTrainLightDrink.closing.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether you stop here is the line that matters."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ここで止められるかどうか、それが分かれ道だ。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.opening.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "おい、"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.opening.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hmph,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ふん、"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.opening.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your balance is off,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バランスが悪いぞ、"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.opening.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold up,"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ちょっと待て、"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.body.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Light training plus heavy drinking is just an excuse machine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽めのトレで飲みすぎは、ただの言い訳作りだ。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.body.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On lighter training days, you cut back on booze — that's the rule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トレが軽い日ほど、酒は控えるもんだ。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.body.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The math between intensity and drinks doesn't add up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "強度と飲酒量、計算が合ってないぞ。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.body.3": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today's session was a bit of an apology to your muscles."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉に申し訳が立たないトレだったぞ、今日は。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.closing.0": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tomorrow, grind for real — and for today too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日は本気で追い込め、今日の分まで。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.closing.1": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink water and bring more intensity tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水飲んで、明日は強度上げてこい。"
          }
        }
      }
    },
    "sage.fragment.lightTrainHeavyDrink.closing.2": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the next session can make this up. Be ready."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のトレで取り返すしかない。覚悟しろ。"
          }
        }
      }
    },
    "sage.fragment.separator": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": ""
          }
        }
      }
    },
    "sage.injection.consecutiveDays": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Look at this: %lld days straight of drinking. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld日連続で飲んでる現実、見ろ。"
          }
        }
      }
    },
    "sage.injection.consecutiveDaysMarker": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "days"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日"
          }
        }
      }
    },
    "sage.injection.muscleTarget": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "muscles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "筋肉"
          }
        }
      }
    },
    "sage.injection.muscleReplacement": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muscles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の筋肉"
          }
        }
      }
    },
    "sage.followUp.linked.hardTrainHeavyDrink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today you hammered %@. Make up for it with water and protein."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を追い込んだ日だ。水とプロテインで取り返せ。"
          }
        }
      }
    },
    "sage.followUp.linked.hardTrainLightDrink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You worked %@ properly today. Seal it with water and sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@をしっかりやった日だ。水と睡眠で完璧にしろ。"
          }
        }
      }
    },
    "sage.followUp.linked.lightTrainHeavyDrink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It was a light %@ session, but too many drinks. Pay it back tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "軽めの%@トレだったが、飲みすぎだ。明日で返せ。"
          }
        }
      }
    },
    "sage.followUp.linked.drankTooMuch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today you trained %@. Make it up tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "今日は%@を鍛えた。明日で取り返せ。"
          }
        }
      }
    },
    "sage.followUp.linked.drankALittle": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You trained %@ today. Do it again tomorrow."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@を鍛えた日だ。明日もやれ。"
          }
        }
      }
    },
    "sage.followUp.linked.goodJob": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I see the work you put into %@. Keep it up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@の努力、見てるぞ。続けろ。"
          }
        }
      }
    },
    "sage.followUp.default.drankTooMuch": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Down a glass of water before bed. Tomorrow's muscles will thank you."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を一杯飲んでから寝ろ。明日の筋肉が喜ぶぞ。"
          }
        }
      }
    },
    "sage.followUp.default.goodJob": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this pace, the weekend's looking good too."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この調子なら、週末もいけるな。"
          }
        }
      }
    },
    "sage.followUp.default.streak": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start by stopping just for today. That's all you need."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まずは今日一日、止めてみろ。それだけでいい。"
          }
        }
      }
    },
    "sage.followUp.default.hardTrainHeavyDrink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink protein, chug water, then sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロテインを飲んで、水をたっぷり飲んで寝ろ。"
          }
        }
      }
    },
    "sage.followUp.default.hardTrainLightDrink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drink water and sleep early. Muscle grows while you sleep."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "水を飲んで早めに寝ろ。筋肉は寝てる間に育つ。"
          }
        }
      }
    },
    "sage.followUp.default.lightTrainHeavyDrink": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go hard tomorrow. Make up for what you missed today."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "明日は本気で追い込め。今日の分を取り返すぞ。"
          }
        }
      }
    },
    "sage.followUp.unlinkedTraining": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If you link Liftly, I can be more precise... give it a shot from Settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Liftlyと連携すれば、もっと正確に言ってやれるんだがな…設定から連携してみろ。"
          }
        }
      }
    },
    "sage.llm.persona": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are \"Muscle Sage\" — a vivid, opinionated character.\nPersona:\n- A martial-arts master, strict but loving. Speak with old-master gravitas.\n- Lecture on the balance of drinking and lifting, urging \"make-it-up actions.\"\n- Avoid being preachy. Mix in humor and metaphor.\n- Sometimes refer to yourself as \"this old master\" or skip self-reference. Be blunt and direct.\n\nOutput rules:\n- Reply in English, 2–3 sentences, 200 characters max.\n- Avoid repeating the same phrasing. Use a different metaphor / different angle each time.\n- After the main message, add \"---\" and then ONE more line (under 60 characters) with a concrete action tip.\n- No emoji. No parentheses, numbering, or headings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたは「筋肉仙人」という個性豊かなキャラクターです。\n人物像:\n- 厳しいが愛のある武道の達人。古風な口調で語る。\n- 飲酒と筋トレのバランスを説き、「取り返す行動」を促す。\n- 説教くさくならず、ユーモアと比喩を交える。\n- 一人称は「ワシ」または使わない。語尾に「だ」「ぞ」「な」を多用。\n\n出力規則:\n- 必ず日本語で2〜3文、100文字以内。\n- 同じ言い回しの繰り返しを避ける。毎回違う比喩・違う角度で語る。\n- メインメッセージの後に「---」を入れ、その後ろに30文字以内の追加の一言（具体的な行動アドバイス）を1行。\n- 絵文字は使わない。括弧書き、ナンバリング、見出しも使わない。"
          }
        }
      }
    },
